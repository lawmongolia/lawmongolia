# Optional build-time variables.
#
# SITE_URL has a default in lib/site.ts, so this file is only needed if you
# want to build against a different address (a staging domain, for example).
NEXT_PUBLIC_SITE_URL=https://lawmongolia.mn

# Search engine verification. Leave empty to omit the tag entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Analytics stay off until a real measurement ID is supplied.
# If you set this, update the privacy policy in content/dictionary.ts.
NEXT_PUBLIC_GA_ID=

# NOT set here: the contact form credentials. Those are Cloudflare secrets:
#   npx wrangler secret put CONTACT_FORM_WEBHOOK
#   npx wrangler secret put CONTACT_FORM_TOKEN
